{
  "name": "vocabulaire",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint src modules __tests__ test-support drizzle.config.ts babel.config.js metro.config.js jest.config.cjs",
    "format": "oxfmt src modules __tests__ test-support drizzle drizzle.config.ts babel.config.js metro.config.js jest.config.cjs app.json package.json pnpm-workspace.yaml tsconfig.json .oxlintrc.json COMPATIBILITY.md BACKUP-FORMAT.md",
    "format:check": "oxfmt --check src modules __tests__ test-support drizzle drizzle.config.ts babel.config.js metro.config.js jest.config.cjs app.json package.json pnpm-workspace.yaml tsconfig.json .oxlintrc.json COMPATIBILITY.md BACKUP-FORMAT.md",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-dev-client": "58.0.18",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.15",
    "expo-localization": "58.0.5",
    "expo-print": "58.0.8",
    "expo-router": "58.0.29",
    "expo-sharing": "58.0.21",
    "expo-splash-screen": "58.0.12",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "i18next": "26.5.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
