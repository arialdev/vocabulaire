{
  "expo": {
    "name": "Vocabulaire",
    "slug": "vocabulaire",
    "version": "1.0.0",
    "icon": "./assets/images/vocabulaire-icon.png",
    "scheme": "vocabulaire",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "dev.arial.vocabulaire",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/vocabulaire-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/vocabulaire-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
